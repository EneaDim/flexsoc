# UART stimulus: direct pins and CSR writes.
# <cycle> <signal> <value> or <cycle> @write <reg> <value> [mask]
0 cio_rx_i 0x00000001
8 cio_rx_i 0x00000000
16 cio_rx_i 0x00000001
24 cio_rx_i 0x00000000
32 cio_rx_i 0x00000001
40 @reset 4
48 @write clk_i.CTRL 0x80000023
52 @write clk_i.FIFO_CTRL 0x00000003
