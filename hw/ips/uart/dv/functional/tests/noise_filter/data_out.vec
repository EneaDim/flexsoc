# UART checks: direct pins and CSR reads.
# <cycle> <signal> <expected> or <cycle> @read <reg> <expected> [mask]
16 tx_o 0x00000001
1472 @read clk_i.CTRL 0x80000007 0xffff00f7
1472 @read clk_i.FIFO_STATUS 0x00040000 0x00ff00ff
1472 @read clk_i.RDATA 0x00000006 0x000000ff
1472 @read clk_i.RDATA 0x00000013 0x000000ff
1472 @read clk_i.RDATA 0x00000028 0x000000ff
1472 @read clk_i.RDATA 0x00000066 0x000000ff
1472 @read clk_i.STATUS 0x0000003c 0x0000003f
1472 @read clk_i.FIFO_STATUS 0x00000000 0x00ff00ff
