1472 @read clk_i.FIFO_STATUS 0x00040000 0x00ff00ff
1472 @read clk_i.RDATA 0x0000004c 0x000000ff
1472 @read clk_i.RDATA 0x00000015 0x000000ff
1472 @read clk_i.RDATA 0x00000076 0x000000ff
1472 @read clk_i.RDATA 0x000000d5 0x000000ff
1472 @read clk_i.STATUS 0x0000003c 0x0000003f
1472 @read clk_i.FIFO_STATUS 0x00000000 0x00ff00ff
