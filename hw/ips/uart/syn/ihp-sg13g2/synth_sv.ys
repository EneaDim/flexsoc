# read target standard cells as library modules for mapped-cell pin directions
read_liberty -overwrite -setattr liberty_cell -lib /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib
# read files (SystemVerilog via slang)
read_slang -I /home/eneadim/github/flexsoc/hw/ips/pkgs \
           -I /home/eneadim/github/flexsoc/hw/ips/prim \
           -I /home/eneadim/github/flexsoc/hw/ips/prim_opentitan \
           -I /home/eneadim/github/flexsoc/hw/ips/tlul \
           -D SYNTHESIS \
           --ignore-assertions \
           -f /tmp/flexsoc-reference-uart/runs/uart/reference/rtl/rtl_common.f \
           -f /tmp/flexsoc-reference-uart/runs/uart/reference/rtl/rtl_ip.f \
           --top uart

# basic synth
synth -top uart -noabc

# technology-boundary checkpoints used by equivalence diagnostics
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/uart_generic.il

# prepare FF types while keeping Yosys FF boundaries visible to ABC
dfflibmap -prepare -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/uart_dffmap.il

# map combinational logic and preserve FF output wires used by EQY
abc -keepff -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib -script /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/area0.abc \
    -constr /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/abc.constr
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/uart_abc.il

# bind the prepared FF types to final technology cells after ABC
dfflibmap -map-only -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib

# Validate mapped connectivity before physical-only netlist finalization
check -assert

# Finalize the implementation-ready technology netlist
splitnets
opt_clean -purge
hilomap -singleton -hicell sg13g2_tiehi L_HI -locell sg13g2_tielo L_LO
insbuf -buf sg13g2_buf_1 A X
check -assert -mapped
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/uart_clean.il

# Basic stats of std cells and area
stat -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib

# Final netlist consumed directly by physical implementation
write_verilog -nohex -nodec /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/uart_synth.v
write_json /tmp/flexsoc-reference-uart/runs/uart/reference/syn/ihp-sg13g2/uart_synth.json
