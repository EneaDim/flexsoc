# read files (SystemVerilog via slang)
read_slang -I /home/eneadim/github/flexsoc/hw/ips/pkgs \
           -I /home/eneadim/github/flexsoc/hw/ips/prim \
           -I /home/eneadim/github/flexsoc/hw/ips/prim_opentitan \
           -I /home/eneadim/github/flexsoc/hw/ips/tlul \
           -D SYNTHESIS \
           --ignore-assertions \
           -f /home/eneadim/github/flexsoc/workspace/runs/uart/dev/rtl/rtl_common.f \
           -f /home/eneadim/github/flexsoc/workspace/runs/uart/dev/rtl/rtl_ip.f \
           --top uart

# basic synth
synth -top uart -noabc

# technology-boundary checkpoints used by equivalence diagnostics
write_rtlil /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/uart_generic.il

# map internal register types to the ones from the cell library
dfflibmap -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib
write_rtlil /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/uart_dffmap.il

# map logic to the selected cell library
abc -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib -script /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/area.abc \
    -constr /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/abc.constr
write_rtlil /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/uart_abc.il

# Clean while preserving public/internal names used by EQY matching and debug
opt_clean
write_rtlil /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/uart_clean.il

# Basic stats of std cells and area
stat -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p50V_25C.lib

# write verilog
write_verilog /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/uart_synth.v
# write json
write_json /home/eneadim/github/flexsoc/workspace/runs/uart/dev/syn/ihp-sg13g2/uart_synth.json
