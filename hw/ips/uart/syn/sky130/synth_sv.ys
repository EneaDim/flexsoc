# read target standard cells as library modules for mapped-cell pin directions
read_liberty -overwrite -setattr liberty_cell -lib /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib
# read files (SystemVerilog via slang)
read_slang -I /home/eneadim/github/flexsoc/hw/ips/pkgs \
           -I /home/eneadim/github/flexsoc/hw/ips/prim \
           -I /home/eneadim/github/flexsoc/hw/ips/prim_opentitan \
           -I /home/eneadim/github/flexsoc/hw/ips/tlul \
           -D SYNTHESIS \
           --ignore-assertions \
           -f /tmp/flexsoc-reference-uart/runs/uart/reference/rtl/rtl_common.f \
           -f /tmp/flexsoc-reference-uart/runs/uart/reference/rtl/rtl_ip.f \
           --top uart

# basic synth
synth -top uart -noabc

# technology-boundary checkpoints used by equivalence diagnostics
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/uart_generic.il

# prepare FF types while keeping Yosys FF boundaries visible to ABC
dfflibmap -prepare -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/uart_dffmap.il

# map combinational logic and preserve FF output wires used by EQY
abc -keepff -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib -script /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/area0.abc \
    -constr /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/abc.constr
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/uart_abc.il

# bind the prepared FF types to final technology cells after ABC
dfflibmap -map-only -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib

# Validate mapped connectivity before physical-only netlist finalization
check -assert

# Finalize the implementation-ready technology netlist
splitnets
opt_clean -purge
hilomap -singleton -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
insbuf -buf sky130_fd_sc_hd__buf_4 A X
check -assert -mapped
write_rtlil /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/uart_clean.il

# Basic stats of std cells and area
stat -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib

# Final netlist consumed directly by physical implementation
write_verilog -nohex -nodec /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/uart_synth.v
write_json /tmp/flexsoc-reference-uart/runs/uart/reference/syn/sky130/uart_synth.json
