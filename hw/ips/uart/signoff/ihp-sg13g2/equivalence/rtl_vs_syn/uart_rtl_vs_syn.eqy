[options]
splitnets off

[gold]
read_slang -D SYNTHESIS --ignore-assertions -f rtl_common.f -f rtl_ip.f --top uart
rename uart uart__eqy_impl
read_verilog -formal -sv uart_eqy_view.sv

[gate]
read_liberty -ignore_miss_func library.lib
read_verilog -formal -sv netlist.v
rename uart uart__eqy_impl
read_verilog -formal -sv uart_eqy_view.sv

[script]
hierarchy -check -top uart
proc
prep -top uart -flatten
memory -nomap
memory_map -formal
async2sync
# FlexSoC EQY reset normalization begin
uniquify
sim -clock clk_i -resetn rst_ni -rstlen 2 -n 2 -w
# FlexSoC EQY reset normalization end

[match uart]
nodefault
gold-match clk_i
gold-match rst_ni
gold-match tl_i
gold-match tl_o__flexsoc_eqy_handshake
gold-match tl_o__flexsoc_eqy_d_ctrl
gold-match tl_o__flexsoc_eqy_d_data
gold-match tl_o__flexsoc_eqy_d_meta
gold-match cio_rx_i
gold-match cio_tx_o
gold-match cio_tx_en_o

# FlexSoC UART sequential cut-points begin
gold-match *u_uart_core.nco_sum_q
gold-match *u_uart_core.uart_tx.baud_div_q
gold-match *u_uart_core.uart_tx.tick_baud_q
gold-match *u_uart_core.u_uart_rxfifo*u_fifo_cnt*wptr_wrap_cnt_q
gold-match *u_uart_core.u_uart_rxfifo*u_fifo_cnt*rptr_wrap_cnt_q
# FlexSoC UART sequential cut-points end

[collect uart]
join tl_o__flexsoc_eqy_handshake
join tl_o__flexsoc_eqy_d_ctrl
join tl_o__flexsoc_eqy_d_data
join tl_o__flexsoc_eqy_d_meta
join *u_uart_core.u_uart_rxfifo*u_fifo_cnt*rptr_wrap_cnt_q
join *u_uart_core.u_uart_rxfifo*u_fifo_cnt*wptr_wrap_cnt_q

[strategy sat]
use sat
depth 5

# The RX FIFO has 16 entries. Keep the fast depth-5 pass for every partition,
# then give only the two FIFO-dependent IHP partitions enough induction depth
# to cover reset, pointer wrap, and one response cycle.
[strategy fifo_sat]
apply uart uart.u_impl.u_uart_core.u_uart_rxfifo.gen_normal_fifo.u_fifo_cnt.wptr_wrap_cnt_q
apply uart uart.tl_o__flexsoc_eqy_d_data
use sat
depth 20

[strategy pdr]
use sby
engine abc pdr
timeout 300
xprop on

[strategy smt]
use sby
engine smtbmc boolector
depth 20
timeout 300
xprop on
