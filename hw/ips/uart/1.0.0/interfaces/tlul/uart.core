CAPI=2:
name: "prj:ip:uart:0.1"
description: "FlexSoC reusable uart IP release"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:flop
      - lowrisc:prim:secded
      - lowrisc:constants:top_pkg
      - lowrisc:prim:mubi
      - lowrisc:tlul:common
      - lowrisc:tlul:adapter_reg
      - lowrisc:prim:buf
      - lowrisc:prim:onehot_check
      - lowrisc:prim:util
      - lowrisc:prim:reg_we_check
      - lowrisc:prim:subreg
      - lowrisc:prim:count
      - lowrisc:prim:fifo
      - lowrisc:prim:flop_2sync
    files:
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/deps/flexsoc/prim/prim_ff_2sync.sv
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/uart_reg_pkg.sv
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/uart_reg_core.sv
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/uart_reg_top.sv
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/uart_tx.sv
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/uart_rx.sv
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/uart_core.sv
      - rtl/deps/flexsoc/workspace/l2_uart_tlul_66W9yAxi/workspace/runs/uart/l2/rtl/uart.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: uart

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"
