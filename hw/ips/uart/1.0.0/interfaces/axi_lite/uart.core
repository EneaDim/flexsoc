CAPI=2:
name: "prj:ip:uart:0.1"
description: "FlexSoC reusable uart IP release"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:flop
      - lowrisc:prim:buf
      - lowrisc:prim:onehot_check
      - lowrisc:prim:util
      - lowrisc:prim:reg_we_check
      - lowrisc:prim:mubi
      - lowrisc:prim:subreg
      - lowrisc:prim:count
      - lowrisc:prim:fifo
      - lowrisc:prim:flop_2sync
    files:
      - rtl/deps/flexsoc/prim/prim_ff_2sync.sv
      - rtl/deps/flexsoc/vendor/pulp/common_cells/src/fifo_v3.sv
      - rtl/deps/flexsoc/vendor/pulp/common_cells/src/cf_math_pkg.sv
      - rtl/deps/flexsoc/vendor/pulp/common_cells/src/lzc.sv
      - rtl/deps/flexsoc/vendor/pulp/common_cells/src/rr_arb_tree.sv
      - rtl/deps/flexsoc/vendor/pulp/common_cells/src/stream_arbiter_flushable.sv
      - rtl/deps/flexsoc/vendor/pulp/common_cells/src/stream_arbiter.sv
      - rtl/deps/flexsoc/vendor/pulp/axi/src/axi_pkg.sv
      - rtl/deps/flexsoc/vendor/pulp/register_interface/src/axi_lite_to_reg.sv
      - rtl/deps/flexsoc/workspace/l2_uart_axi_lite_jWQf0G6W/workspace/runs/uart/l2/rtl/uart_reg_pkg.sv
      - rtl/deps/flexsoc/workspace/l2_uart_axi_lite_jWQf0G6W/workspace/runs/uart/l2/rtl/uart_reg_core.sv
      - rtl/deps/flexsoc/workspace/l2_uart_axi_lite_jWQf0G6W/workspace/runs/uart/l2/rtl/uart_reg_top.sv
      - rtl/deps/flexsoc/workspace/l2_uart_axi_lite_jWQf0G6W/workspace/runs/uart/l2/rtl/uart_tx.sv
      - rtl/deps/flexsoc/workspace/l2_uart_axi_lite_jWQf0G6W/workspace/runs/uart/l2/rtl/uart_rx.sv
      - rtl/deps/flexsoc/workspace/l2_uart_axi_lite_jWQf0G6W/workspace/runs/uart/l2/rtl/uart_core.sv
      - rtl/deps/flexsoc/workspace/l2_uart_axi_lite_jWQf0G6W/workspace/runs/uart/l2/rtl/uart.sv
      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/assign.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/axi/include
      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/port.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/axi/include
      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/typedef.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/axi/include
      - rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface/assign.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/register_interface/include
      - rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface/typedef.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/register_interface/include
      - rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface/assign.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface
      - rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface/typedef.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface
      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/assign.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/axi/include/axi
      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/port.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/axi/include/axi
      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/typedef.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/axi/include/axi
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: uart

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"
