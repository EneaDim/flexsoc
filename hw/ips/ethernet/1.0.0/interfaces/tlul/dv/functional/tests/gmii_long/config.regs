# format: <CLOCK.REG_NAME> <DATA> [MASK] [WAIT_CYCLES] [NOTE]
# map clk_i.INTR_STATE 0x00000000
# map clk_i.INTR_ENABLE 0x00000004
# map clk_i.INTR_TEST 0x00000008
# map clk_i.CTRL 0x0000000c
# map clk_i.IFG 0x00000010
# map clk_i.STATUS 0x00000014
# map clk_i.TX_UNDERFLOW_COUNT 0x00000018
# map clk_i.RX_BAD_FRAME_COUNT 0x0000001c
# map clk_i.RX_BAD_FCS_COUNT 0x00000020
