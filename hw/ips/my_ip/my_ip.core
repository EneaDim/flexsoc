CAPI=2:
name: "prj:ip:my_ip:0.1"
description: "my_ip"
filesets:
  files_rtl:
    depend:
      - ips:dependecies:all
    files:
      - /home/eneadim/github/flexsoc/workspace/runs/my_ip/dev1/rtl/my_ip_reg_top.sv
      - /home/eneadim/github/flexsoc/workspace/runs/my_ip/dev1/rtl/my_ip_reg_pkg.sv
      - /home/eneadim/github/flexsoc/workspace/runs/my_ip/dev1/rtl/my_ip.sv
      - /home/eneadim/github/flexsoc/workspace/runs/my_ip/dev1/rtl/my_ip_core.sv
    file_type: systemVerilogSource


targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: my_ip

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"

