CAPI=2:
name: "prj:ip:spi_host:0.1"
description: "spi_host"
filesets:
  files_rtl:
    depend:
      - ips:dependecies:all
    files:
      - rtl/spi_host_reg_pkg.sv
      - rtl/spi_host_reg_top.sv
      - rtl/spi_host_core.sv
      - rtl/spi_host.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: spi_host

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"

