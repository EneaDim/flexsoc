CAPI=2:
name: "prj:ip:gpio:0.1"
description: "FlexSoC reusable gpio IP release"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:flop
      - lowrisc:prim:secded
      - lowrisc:constants:top_pkg
      - lowrisc:prim:mubi
      - lowrisc:tlul:common
      - lowrisc:tlul:adapter_reg
      - lowrisc:prim:buf
      - lowrisc:prim:onehot_check
      - lowrisc:prim:util
      - lowrisc:prim:reg_we_check
      - lowrisc:prim:subreg
      - lowrisc:prim:flop_2sync
    files:
      - rtl/gpio_reg_pkg.sv
      - rtl/gpio_reg_core.sv
      - rtl/gpio_reg_top.sv
      - rtl/gpio_core.sv
      - rtl/gpio.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: gpio

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"
