CAPI=2:
name: "prj:ip:gpio:0.1"
description: "FlexSoC reusable gpio IP release"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:flop
      - lowrisc:prim:secded
      - lowrisc:constants:top_pkg
      - lowrisc:prim:mubi
      - lowrisc:tlul:common
      - lowrisc:tlul:adapter_reg
      - lowrisc:prim:buf
      - lowrisc:prim:onehot_check
      - lowrisc:prim:util
      - lowrisc:prim:reg_we_check
      - lowrisc:prim:subreg
      - lowrisc:prim:flop_2sync
    files:
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_flop.sv
      - rtl/deps/flexsoc/hw/ips/prim/prim_ff_2sync.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_secded_inv_64_57_enc.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_secded_inv_39_32_enc.sv
      - rtl/deps/flexsoc/hw/ips/pkgs/top_pkg.sv
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_mubi_pkg.sv
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_secded_pkg.sv
      - rtl/deps/flexsoc/vendor/lowrisc_ip/ip/tlul/rtl/tlul_pkg.sv
      - rtl/deps/flexsoc/vendor/lowrisc_ip/ip/tlul/rtl/tlul_data_integ_enc.sv
      - rtl/deps/flexsoc/vendor/lowrisc_ip/ip/tlul/rtl/tlul_rsp_intg_gen.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_secded_inv_64_57_dec.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_secded_inv_39_32_dec.sv
      - rtl/deps/flexsoc/vendor/lowrisc_ip/ip/tlul/rtl/tlul_data_integ_dec.sv
      - rtl/deps/flexsoc/vendor/lowrisc_ip/ip/tlul/rtl/tlul_cmd_intg_chk.sv
      - rtl/deps/flexsoc/vendor/lowrisc_ip/ip/tlul/rtl/tlul_err.sv
      - rtl/deps/flexsoc/vendor/lowrisc_ip/ip/tlul/rtl/tlul_adapter_reg.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_buf.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_onehot_check.sv
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_util_pkg.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_reg_we_check.sv
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_subreg_pkg.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_subreg_arb.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_subreg.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_subreg_ext.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_flop_2sync.sv
      - rtl/deps/flexsoc/hw/ips/prim_opentitan/prim_filter_ctr.sv
      - rtl/gpio_reg_pkg.sv
      - rtl/gpio_reg_core.sv
      - rtl/gpio_reg_top.sv
      - rtl/gpio_core.sv
      - rtl/gpio.sv
      - rtl/deps/flexsoc/hw/ips/pkgs/assertions.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/assign.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/dv_fcov_macros.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_alert_pkg.sv:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_assert.sv:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_assert_dummy_macros.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_assert_sec_cm.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_assert_standard_macros.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_count_pkg.sv:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/prim_flop_macros.sv:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/registers.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
      - rtl/deps/flexsoc/hw/ips/pkgs/typedef.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/hw/ips/pkgs
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: gpio

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"
