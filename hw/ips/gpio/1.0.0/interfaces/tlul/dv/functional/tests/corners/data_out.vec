# GPIO checks: direct outputs and CSR reads.
# <cycle> <signal> <expected> or <cycle> @read <reg> <expected> [mask]
16 @read clk_i.DATA_IN 0x00000000 0x0000000f
20 cio_gpio_o 0x00000000
20 cio_gpio_en_o 0x00000000
36 @read clk_i.DATA_IN 0x0000000f 0x0000000f
52 cio_gpio_o 0x0000000f
52 cio_gpio_en_o 0x0000000f
