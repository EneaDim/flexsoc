# CORDIC CSR stimulus generated from the behavioral model.
# format: <cycle> @write <clock.reg> <data> [mask]
0 @write clk_i.X_IN 0x00000000
1 @write clk_i.Y_IN 0x00000000
2 @write clk_i.Z_IN 0x00000000
3 @write clk_i.CTRL 0x00001001
4 @write clk_i.CTRL 0x00001000
80 @write clk_i.X_IN 0x00001000
81 @write clk_i.Y_IN 0x00000000
82 @write clk_i.Z_IN 0x00000000
83 @write clk_i.CTRL 0x00001001
84 @write clk_i.CTRL 0x00001000
