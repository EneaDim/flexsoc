# format: <CLOCK.REG_NAME> <DATA> [MASK] [WAIT_CYCLES] [NOTE]
# map clk_i.CTRL 0x00000000
# map clk_i.STATUS 0x00000004
# map clk_i.X_IN 0x00000008
# map clk_i.Y_IN 0x0000000c
# map clk_i.Z_IN 0x00000010
# map clk_i.X_OUT 0x00000014
# map clk_i.Y_OUT 0x00000018
# map clk_i.Z_OUT 0x0000001c
# map clk_i.CFG 0x00000020
