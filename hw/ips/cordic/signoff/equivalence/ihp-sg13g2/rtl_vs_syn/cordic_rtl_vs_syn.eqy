[options]
splitnets off

[gold]
read_slang -D SYNTHESIS --ignore-assertions -f rtl_common.f -f rtl_ip.f --top cordic
rename cordic cordic__eqy_impl
read_verilog -formal -sv cordic_eqy_view.sv

[gate]
read_liberty -ignore_miss_func library.lib
read_verilog -formal -sv netlist.v
rename cordic cordic__eqy_impl
read_verilog -formal -sv cordic_eqy_view.sv

[script]
hierarchy -check -top cordic
proc
prep -top cordic -flatten
memory -nomap
memory_map -formal
async2sync
# FlexSoC EQY reset normalization begin
uniquify
sim -clock clk_i -resetn rst_ni -rstlen 2 -n 2 -w
# FlexSoC EQY reset normalization end

[match cordic]
nodefault
gold-match clk_i
gold-match rst_ni
gold-match tl_i
gold-match tl_o__flexsoc_eqy_handshake
gold-match tl_o__flexsoc_eqy_d_ctrl
gold-match tl_o__flexsoc_eqy_d_data
gold-match tl_o__flexsoc_eqy_d_meta
# FlexSoC CORDIC IHP proven cut-points begin
gold-match *u_cordic_core.x_q
gold-match *u_cordic_core.y_q
gold-match *u_cordic_core.z_q
gold-match *u_cordic_core.mode_q
gold-match *u_cordic_core.status_error
gold-match *u_cordic_core.u_start_edge_detect.serial_q
# FlexSoC CORDIC IHP proven cut-points end

[collect cordic]
join tl_o__flexsoc_eqy_handshake
join tl_o__flexsoc_eqy_d_ctrl
join tl_o__flexsoc_eqy_d_data
join tl_o__flexsoc_eqy_d_meta

[strategy sat]
use sat
depth 5

[strategy pdr]
use sby
engine abc pdr
timeout 60
xprop on

[strategy smt]
use sby
engine smtbmc boolector
depth 2
timeout 60
xprop on
