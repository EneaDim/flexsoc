# read files (SystemVerilog via slang)
read_slang -I /home/eneadim/github/flexsoc/hw/ips/pkgs \
           -I /home/eneadim/github/flexsoc/hw/ips/prim \
           -I /home/eneadim/github/flexsoc/hw/ips/prim_opentitan \
           -I /home/eneadim/github/flexsoc/hw/ips/tlul \
           -D SYNTHESIS \
           --ignore-assertions \
           -f /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/rtl/rtl_common.f \
           -f /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/rtl/rtl_ip.f \
           --top cordic

# basic synth
synth -top cordic -noabc

# technology-boundary checkpoints used by equivalence diagnostics
write_rtlil /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/cordic_generic.il

# map internal register types to the ones from the cell library
dfflibmap -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib
write_rtlil /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/cordic_dffmap.il

# map logic to the selected cell library
abc -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib -script /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/area.abc \
    -constr /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/abc.constr
write_rtlil /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/cordic_abc.il

# Clean while preserving public/internal names used by EQY matching and debug
opt_clean
write_rtlil /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/cordic_clean.il

# Basic stats of std cells and area
stat -liberty /home/eneadim/github/flexsoc/.flexsoc/pdks/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib

# write verilog
write_verilog /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/cordic_synth.v
# write json
write_json /home/eneadim/github/flexsoc/workspace/cordic-full-flow/runs/cordic/dev/syn/sky130/cordic_synth.json
