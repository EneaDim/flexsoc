CAPI=2:
name: "prj:ip:fft_core:0.1"
description: "fft_core"
filesets:
  files_rtl:
    depend:
      - ips:dependecies:all
    files:
      - rtl/fft_fsm_pkg.sv
      - rtl/fft_core_reg_pkg.sv
      - rtl/fft_core_reg_top.sv
      - rtl/fft_core.sv
      - rtl/fft_fsm.sv
      - rtl/twiddle_rom.sv
      - rtl/twiddle_rom_1024.sv
      - rtl/twiddle_rom_16.sv
      - rtl/twiddle_rom_256.sv
      - rtl/twiddle_rom_64.sv
      - rtl/twiddle_rom_8.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: fft_core

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"

