      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/port.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/axi/include
      - rtl/deps/flexsoc/vendor/pulp/axi/include/axi/typedef.svh:
          is_include_file: true
