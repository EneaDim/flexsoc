      - rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface/assign.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/register_interface/include
      - rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface/typedef.svh:
          is_include_file: true
          include_path: rtl/deps/flexsoc/vendor/pulp/register_interface/include
      - rtl/deps/flexsoc/vendor/pulp/register_interface/include/register_interface/assign.svh:
          is_include_file: true
