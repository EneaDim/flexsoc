CAPI=2:
name: "prj:ip:rv_timer:0.1"
description: "FlexSoC reusable rv_timer IP release"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:flop
      - lowrisc:prim:buf
      - lowrisc:prim:onehot_check
      - lowrisc:prim:util
      - lowrisc:prim:reg_we_check
      - lowrisc:prim:mubi
      - lowrisc:prim:subreg
    files:
      - rtl/rv_timer_reg_pkg.sv
      - rtl/rv_timer_reg_core.sv
      - rtl/rv_timer_reg_top.sv
      - rtl/rv_timer_core.sv
      - rtl/rv_timer.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: rv_timer

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"
