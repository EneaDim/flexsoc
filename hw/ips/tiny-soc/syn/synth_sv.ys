# read files (SystemVerilog via slang)
read_slang -I ../hw/ips/pkgs \
           -I ../hw/ips/prim \
           -I ../hw/ips/prim_opentitan \
           -I ../hw/ips/tlul \
           -D SYNTHESIS \
           --ignore-assertions \
           -f /home/eneadim/github/flexsoc/workspace/runs/tiny-soc/dev/rtl/rtl_list.f \
           --top soc

# basic synth
synth -top soc -noabc

# map internal register types to the ones from the cell library
dfflibmap -liberty /home/eneadim/github/flexsoc/pdks/sky130/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# mapping to internal cell library
abc -liberty /home/eneadim/github/flexsoc/pdks/sky130/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -script /home/eneadim/github/flexsoc/workspace/runs/tiny-soc/dev/syn/area.abc \
    -constr /home/eneadim/github/flexsoc/workspace/runs/tiny-soc/dev/pnr_openroad/soc.sdc \

# Clean
opt_clean -purge

# Basic stats of std cells and area
stat -liberty /home/eneadim/github/flexsoc/pdks/sky130/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# write verilog
write_verilog /home/eneadim/github/flexsoc/workspace/runs/tiny-soc/dev/syn/soc_synth.v
# write json
write_json /home/eneadim/github/flexsoc/workspace/runs/tiny-soc/dev/syn/soc_synth.json
