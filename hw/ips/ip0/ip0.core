CAPI=2:
name: "prj:ip:ip0:0.1"
description: "ip0"
filesets:
  files_rtl:
    depend:
      - ips:dependecies:all
    files:
      - /home/eneadim/github/flexsoc/workspace/runs/ip0/dev/rtl/ip0_reg_pkg.sv
      - /home/eneadim/github/flexsoc/workspace/runs/ip0/dev/rtl/ip0.sv
      - /home/eneadim/github/flexsoc/workspace/runs/ip0/dev/rtl/ip0_reg_top.sv
      - /home/eneadim/github/flexsoc/workspace/runs/ip0/dev/rtl/ip0_core.sv
    file_type: systemVerilogSource


targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: ip0

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"

