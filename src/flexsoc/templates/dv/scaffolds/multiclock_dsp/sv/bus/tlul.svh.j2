      // Shared timing intent: every domain drives/samples from its clock period and IO delay.
      task automatic apply_defaults();
        cfg_tl_i = flexsoc_tlul_h2d(1'b0, FLEXSOC_TL_GET, 3'b0, 2'd2, 8'b0,
