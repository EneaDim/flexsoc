// Shared timing intent: every register window uses its owning clock domain.
task automatic apply_defaults();
<<% for window in windows %>>  <<: window :>>_reg_req_i = '0;
<<% endfor %>><<: input_defaults :>>
endtask

<<: reset_tasks :>><<% for window in windows %>>task automatic <<: window :>>_write(input logic [31:0] addr, input logic [31:0] data);
  <<: window :>>_drive_cycle();
  <<: window :>>_reg_req_i.valid = 1'b1;
  <<: window :>>_reg_req_i.write = 1'b1;
  <<: window :>>_reg_req_i.addr = addr;
  <<: window :>>_reg_req_i.wdata = data;
  <<: window :>>_reg_req_i.wstrb = '1;
  do <<: window :>>_sample_cycle(); while (!<<: window :>>_reg_rsp_o.ready);
  if (<<: window :>>_reg_rsp_o.error) errors++;
  <<: window :>>_drive_cycle();
  <<: window :>>_reg_req_i = '0;
endtask

task automatic <<: window :>>_read(input logic [31:0] addr, output logic [31:0] data);
  <<: window :>>_drive_cycle();
  <<: window :>>_reg_req_i.valid = 1'b1;
  <<: window :>>_reg_req_i.write = 1'b0;
  <<: window :>>_reg_req_i.addr = addr;
  <<: window :>>_reg_req_i.wdata = '0;
  <<: window :>>_reg_req_i.wstrb = '0;
  do <<: window :>>_sample_cycle(); while (!<<: window :>>_reg_rsp_o.ready);
  data = <<: window :>>_reg_rsp_o.rdata;
  if (<<: window :>>_reg_rsp_o.error) errors++;
  <<: window :>>_drive_cycle();
  <<: window :>>_reg_req_i = '0;
endtask

<<% endfor %>>