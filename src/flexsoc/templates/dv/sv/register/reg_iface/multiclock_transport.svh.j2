// Shared timing intent: every domain drives/samples from its clock period and IO delay.
task automatic apply_defaults();
  cfg_reg_req_i = '0;
  dsp_reg_req_i = '0;
  rx_valid_i = 1'b0;
  rx_sample_i = '0;
  rx_coeff_i = '0;
  dsp_ready_i = 1'b1;
endtask

<<: reset_tasks :>>task automatic cfg_write(input logic [31:0] addr, input logic [31:0] data);
  cfg_drive_cycle();
  cfg_reg_req_i.valid = 1'b1;
  cfg_reg_req_i.write = 1'b1;
  cfg_reg_req_i.addr = addr;
  cfg_reg_req_i.wdata = data;
  cfg_reg_req_i.wstrb = '1;
  do cfg_sample_cycle(); while (!cfg_reg_rsp_o.ready);
  if (cfg_reg_rsp_o.error) errors++;
  cfg_drive_cycle();
  cfg_reg_req_i = '0;
endtask

task automatic cfg_read(input logic [31:0] addr, output logic [31:0] data);
  cfg_drive_cycle();
  cfg_reg_req_i.valid = 1'b1;
  cfg_reg_req_i.write = 1'b0;
  cfg_reg_req_i.addr = addr;
  cfg_reg_req_i.wdata = '0;
  cfg_reg_req_i.wstrb = '0;
  do cfg_sample_cycle(); while (!cfg_reg_rsp_o.ready);
  data = cfg_reg_rsp_o.rdata;
  if (cfg_reg_rsp_o.error) errors++;
  cfg_drive_cycle();
  cfg_reg_req_i = '0;
endtask

task automatic dsp_write(input logic [31:0] addr, input logic [31:0] data);
  dsp_drive_cycle();
  dsp_reg_req_i.valid = 1'b1;
  dsp_reg_req_i.write = 1'b1;
  dsp_reg_req_i.addr = addr;
  dsp_reg_req_i.wdata = data;
  dsp_reg_req_i.wstrb = '1;
  do dsp_sample_cycle(); while (!dsp_reg_rsp_o.ready);
  if (dsp_reg_rsp_o.error) errors++;
  dsp_drive_cycle();
  dsp_reg_req_i = '0;
endtask

task automatic dsp_read(input logic [31:0] addr, output logic [31:0] data);
  dsp_drive_cycle();
  dsp_reg_req_i.valid = 1'b1;
  dsp_reg_req_i.write = 1'b0;
  dsp_reg_req_i.addr = addr;
  dsp_reg_req_i.wdata = '0;
  dsp_reg_req_i.wstrb = '0;
  do dsp_sample_cycle(); while (!dsp_reg_rsp_o.ready);
  data = dsp_reg_rsp_o.rdata;
  if (dsp_reg_rsp_o.error) errors++;
  dsp_drive_cycle();
  dsp_reg_req_i = '0;
endtask

