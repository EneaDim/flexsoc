// One CSR transport contract; each window follows its owning clock domain.
task automatic apply_defaults();
<<% for window in windows %>>  <<: window.request :>> = '0;
<<% endfor %>><<: input_defaults :>>
endtask

<<: reset_tasks :>><<% for window in windows %>>task automatic <<: window.name :>>_write(input logic [31:0] addr, input logic [31:0] data);
  logic [2:0] opcode;
  opcode = FLEXSOC_TL_PUT_FULL;
  <<: window.domain :>>_drive_cycle();
  <<: window.request :>> = flexsoc_tlul_h2d(1'b1, opcode, 3'b0, 2'd2, 8'h00, addr, 4'hf, data, 1'b1);
  do <<: window.domain :>>_sample_cycle(); while (!<<: window.response :>>[0]);
  <<: window.domain :>>_drive_cycle();
  <<: window.request :>>[108] = 1'b0;
  do <<: window.domain :>>_sample_cycle(); while (!<<: window.response :>>[65]);
  if (<<: window.response :>>[1]) errors++;
  <<: window.domain :>>_drive_cycle();
  <<: window.request :>> = flexsoc_tlul_h2d(1'b0, 3'b0, 3'b0, 2'd0, 8'h00, 32'b0, 4'b0, 32'b0, 1'b1);
endtask

task automatic <<: window.name :>>_read(input logic [31:0] addr, output logic [31:0] data);
  <<: window.domain :>>_drive_cycle();
  <<: window.request :>> = flexsoc_tlul_h2d(1'b1, FLEXSOC_TL_GET, 3'b0, 2'd2, 8'h00, addr, 4'hf, 32'b0, 1'b1);
  do <<: window.domain :>>_sample_cycle(); while (!<<: window.response :>>[0]);
  <<: window.domain :>>_drive_cycle();
  <<: window.request :>>[108] = 1'b0;
  do <<: window.domain :>>_sample_cycle(); while (!<<: window.response :>>[65]);
  data = <<: window.response :>>[47:16];
  if (<<: window.response :>>[1]) errors++;
  <<: window.domain :>>_drive_cycle();
  <<: window.request :>> = flexsoc_tlul_h2d(1'b0, 3'b0, 3'b0, 2'd0, 8'h00, 32'b0, 4'b0, 32'b0, 1'b1);
endtask

<<% endfor %>>
