// Shared timing intent: every register window uses its owning clock domain.
task automatic apply_defaults();
<<% for window in windows %>>  <<: window :>>_tl_i = flexsoc_tlul_h2d(1'b0, FLEXSOC_TL_GET, 3'b0, 2'd2, 8'b0,
                              32'b0, 4'b0, 32'b0, 1'b1);
<<% endfor %>><<: input_defaults :>>
endtask

<<: reset_tasks :>><<% for window in windows %>>task automatic <<: window :>>_write(input logic [31:0] addr, input logic [31:0] data);
  <<: window :>>_drive_cycle();
  <<: window :>>_tl_i = flexsoc_tlul_h2d(1'b1, FLEXSOC_TL_PUT_FULL, 3'b0, 2'd2, 8'b0,
                              addr, 4'hf, data, 1'b1);
  do <<: window :>>_sample_cycle(); while (!<<: window :>>_tl_o[0]);
  <<: window :>>_drive_cycle();
  <<: window :>>_tl_i[108] = 1'b0;
  do <<: window :>>_sample_cycle(); while (!<<: window :>>_tl_o[65]);
  if (<<: window :>>_tl_o[1]) errors++;
  <<: window :>>_drive_cycle();
  <<: window :>>_tl_i = flexsoc_tlul_h2d(1'b0, FLEXSOC_TL_GET, 3'b0, 2'd2, 8'b0,
                              32'b0, 4'b0, 32'b0, 1'b1);
endtask

task automatic <<: window :>>_read(input logic [31:0] addr, output logic [31:0] data);
  <<: window :>>_drive_cycle();
  <<: window :>>_tl_i = flexsoc_tlul_h2d(1'b1, FLEXSOC_TL_GET, 3'b0, 2'd2, 8'b0,
                              addr, 4'hf, 32'b0, 1'b1);
  do <<: window :>>_sample_cycle(); while (!<<: window :>>_tl_o[0]);
  <<: window :>>_drive_cycle();
  <<: window :>>_tl_i[108] = 1'b0;
  do <<: window :>>_sample_cycle(); while (!<<: window :>>_tl_o[65]);
  data = <<: window :>>_tl_o[47:16];
  if (<<: window :>>_tl_o[1]) errors++;
  <<: window :>>_drive_cycle();
  <<: window :>>_tl_i = flexsoc_tlul_h2d(1'b0, FLEXSOC_TL_GET, 3'b0, 2'd2, 8'b0,
                              32'b0, 4'b0, 32'b0, 1'b1);
endtask

<<% endfor %>>