// Expected rows are grouped by logical vector step and consumed in order.
task automatic load_expected(input string path);
  integer fd;
  integer code;
  integer step;
  integer current_step;
<<% if packed %>>  tb_token_t sig;
<<% else %>>  string sig;
<<% endif %>>  logic [31:0] value;
<<% if packed %>>  tb_line_t line_buf;
<<% else %>>  string line;
  reg [8*4096-1:0] line_buf;
<<% endif %>>  begin : load_expected_body
  exp_count = 0;
  current_step = -1;
  fd = $fopen(path, "r");
  if (fd == 0) begin
    $display("[TB][ERROR] expected file not found: %s", path);
    errors++;
    disable load_expected_body;
  end
  while (!$feof(fd)) begin : tb_nclk_expected_line
<<% if packed %>><<% else %>>    line = "";
<<% endif %>>    line_buf = '0;
<<% if packed %>>    code = $fgets(line_buf, fd);
    code = $sscanf(line_buf, "%d %s %h", step, sig, value);
<<% else %>>    void'($fgets(line_buf, fd));
    line = $sformatf("%0s", line_buf);
    if (line.len() == 0 || line.substr(0, 0) == "#") disable tb_nclk_expected_line;
    code = $sscanf(line, "%d %s %h", step, sig, value);
<<% endif %>>    if (code == 3) begin
      if (step != current_step) begin
        current_step = step;
<<: clear_expected :>>
        exp_count++;
      end
<<: load_cases :>>
    end
  end
  $fclose(fd);
  end
endtask

task automatic check_outputs();
  integer timeout;
  got_count = 0;
  timeout = 0;
  while (got_count < exp_count && timeout < 4096) begin
    <<: sample_cycle :>>;
    if (<<: valid_expr :>>) begin
<<: check_cases :>>
      got_count++;
    end
    timeout++;
  end
  if (got_count != exp_count) begin
    $display("[TB][ERROR] observed %0d/%0d expected outputs", got_count, exp_count);
    errors++;
  end
endtask
