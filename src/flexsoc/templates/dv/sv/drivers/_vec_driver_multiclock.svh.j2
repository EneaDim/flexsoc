<<: stream_state :>>
<<: stream_helpers :>>
task automatic wait_output_completion;
  integer timeout;
  begin : wait_output_completion_body
  timeout = 0;
<<: wait_output_body :>>
  end
endtask

task automatic run_inputs(input string path);
  integer fd;
  integer code;
  integer step;
  integer cycles;
<<% if packed %>>  tb_token_t token;
  tb_token_t reg_name;
<<% else %>>  string token;
  string reg_name;
<<% endif %>>  string reset_selector;
  logic [31:0] value;
  logic [31:0] mask;
<<% if packed %>>  tb_line_t line_buf;
<<% else %>>  string line;
  reg [8*4096-1:0] line_buf;
<<% endif %>>  begin : run_inputs_body
  fd = $fopen(path, "r");
  if (fd == 0) begin
    $display("[TB][ERROR] input file not found: %s", path);
    errors++;
    disable run_inputs_body;
  end
  while (!$feof(fd)) begin : tb_nclk_input_line
<<% if packed %>><<% else %>>    line = "";
<<% endif %>>    line_buf = '0;
<<% if packed %>>    code = $fgets(line_buf, fd);
    code = $sscanf(line_buf, "%d %s", step, token);
<<% else %>>    void'($fgets(line_buf, fd));
    line = $sformatf("%0s", line_buf);
    if (line.len() == 0 || line.substr(0, 0) == "#") disable tb_nclk_input_line;
    code = $sscanf(line, "%d %s", step, token);
<<% endif %>>    if (code != 2) disable tb_nclk_input_line;
    if (token == "@wait_output" || token == "wait_output") begin
      wait_output_completion();
    end else if (token == "@write" || token == "write") begin
<<% if packed %>>      code = $sscanf(line_buf, "%d %s %s %h", step, token, reg_name, value);
<<% else %>>      code = $sscanf(line, "%d %s %s %h", step, token, reg_name, value);
<<% endif %>>      if (code == 4) begin
        mask = 32'hffff_ffff;
<<% if packed %>>        if ($sscanf(line_buf, "%d %s %s %h %h", step, token, reg_name, value, mask) != 5)
<<% else %>>        if ($sscanf(line, "%d %s %s %h %h", step, token, reg_name, value, mask) != 5)
<<% endif %>>          mask = 32'hffff_ffff;
        apply_reg_masked(reg_name, value, mask);
        repeat (8) <<: settle_cycle :>>;
      end
    end else if (token == "@read" || token == "read") begin
<<% if packed %>>      code = $sscanf(line_buf, "%d %s %s %h", step, token, reg_name, value);
<<% else %>>      code = $sscanf(line, "%d %s %s %h", step, token, reg_name, value);
<<% endif %>>      if (code == 4) begin
        mask = 32'hffff_ffff;
<<% if packed %>>        if ($sscanf(line_buf, "%d %s %s %h %h", step, token, reg_name, value, mask) != 5)
<<% else %>>        if ($sscanf(line, "%d %s %s %h %h", step, token, reg_name, value, mask) != 5)
<<% endif %>>          mask = 32'hffff_ffff;
        expect_reg(reg_name, value, mask);
      end
    end else if (token == "@reset" || token == "reset") begin
      reset_selector = "all";
<<% if packed %>>      code = $sscanf(line_buf, "%d %s %s %d", step, token, reset_selector, cycles);
<<% else %>>      code = $sscanf(line, "%d %s %s %d", step, token, reset_selector, cycles);
<<% endif %>>      if (code == 3) begin
<<% if packed %>>        code = $sscanf(line_buf, "%d %s %d", step, token, cycles);
<<% else %>>        code = $sscanf(line, "%d %s %d", step, token, cycles);
<<% endif %>>        reset_selector = "all";
      end
      if (code == 3 || code == 4) reset_dut(reset_selector, cycles);
      else begin
        $display("[TB][ERROR] @reset format: cycle @reset [domain|reset] cycles");
        errors++;
      end
    end else begin
<<% if packed %>>      code = $sscanf(line_buf, "%d %s %h", step, token, value);
<<% else %>>      code = $sscanf(line, "%d %s %h", step, token, value);
<<% endif %>>      if (code != 3) disable tb_nclk_input_line;
<<: drive_cases :>>
    end
  end
  $fclose(fd);
  end
endtask
