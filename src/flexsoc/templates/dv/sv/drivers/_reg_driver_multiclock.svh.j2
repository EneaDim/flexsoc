<<% if packed %>><<: phase_helpers :>><<: bus_section :>>      task automatic apply_reg(input tb_token_t reg_name, input logic [31:0] value);
<<% else %>><<: phase_helpers :>><<: bus_section :>>      task automatic apply_reg(input string reg_name, input logic [31:0] value);
<<% endif %>><<: write_cases :>>
      endtask

<<% if packed %>>      task automatic read_reg(input tb_token_t reg_name, output logic [31:0] value);
<<% else %>>      task automatic read_reg(input string reg_name, output logic [31:0] value);
<<% endif %>>        value = '0;
<<: read_cases :>>
      endtask

      task automatic apply_reg_masked(
<<% if packed %>>        input tb_token_t reg_name,
<<% else %>>        input string reg_name,
<<% endif %>>        input logic [31:0] value,
        input logic [31:0] mask
      );
        logic [31:0] current;
        logic [31:0] merged;
        merged = value;
        if (mask != 32'hffff_ffff) begin
          read_reg(reg_name, current);
          merged = (current & ~mask) | (value & mask);
        end
        apply_reg(reg_name, merged);
      endtask

      task automatic expect_reg(
<<% if packed %>>        input tb_token_t reg_name,
<<% else %>>        input string reg_name,
<<% endif %>>        input logic [31:0] expected,
        input logic [31:0] mask
      );
        logic [31:0] got;
        read_reg(reg_name, got);
        if ((got & mask) !== (expected & mask)) begin
          $display("[TB][ERROR] %s got=0x%08x exp=0x%08x mask=0x%08x", reg_name, got, expected, mask);
          errors++;
        end
      endtask

      task automatic load_config(input string path);
        integer fd;
        integer code;
<<% if packed %>>        tb_token_t reg_name;
<<% else %>>        string reg_name;
<<% endif %>>        logic [31:0] value;
        logic [31:0] mask;
<<% if packed %>>              tb_line_t line_buf;
<<% else %>>        string line;
        reg [8*4096-1:0] line_buf;
<<% endif %>>        begin : load_config_body
        fd = $fopen(path, "r");
        if (fd == 0) begin
          $display("[TB][ERROR] config file not found: %s", path);
          errors++;
          disable load_config_body;
        end
        while (!$feof(fd)) begin : tb_nclk_cfg_line
<<% if packed %>>                line_buf = '0;
          code = $fgets(line_buf, fd);
          code = $sscanf(line_buf, "%s %h", reg_name, value);
<<% else %>>          line = "";
          line_buf = '0;
          void'($fgets(line_buf, fd));
          line = $sformatf("%0s", line_buf);
          if (line.len() == 0 || line.substr(0, 0) == "#") disable tb_nclk_cfg_line;
          code = $sscanf(line, "%s %h", reg_name, value);
<<% endif %>>          if (code == 2) begin
            mask = 32'hffff_ffff;
<<% if packed %>>            if ($sscanf(line_buf, "%s %h %h", reg_name, value, mask) != 3)
<<% else %>>            if ($sscanf(line, "%s %h %h", reg_name, value, mask) != 3)
<<% endif %>>              mask = 32'hffff_ffff;
<<% if packed %>>            begin
              tb_token_t short_name;
              short_name = '0;
              if ($sscanf(reg_name, "clk_i.%s", short_name) == 1) reg_name = short_name;
            end
<<% else %>>            if (reg_name.len() > 6 && reg_name.substr(0, 5) == "clk_i.") reg_name = reg_name.substr(6, reg_name.len() - 1);
<<% endif %>>            apply_reg_masked(reg_name, value, mask);
          end
        end
        $fclose(fd);
        end
      endtask
