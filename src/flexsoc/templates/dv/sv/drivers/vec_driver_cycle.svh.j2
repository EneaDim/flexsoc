// Auto-generated vector driver for <<: top :>>.
// data_in.vec supports signal drives, @write, @cfg, @reset and synchronization barriers.

int tb_vector_apply_count;
localparam realtime FLEXSOC_VEC_DRIVE_NS  = <<: drive_ns :>>;
localparam realtime FLEXSOC_VEC_SAMPLE_NS = <<: sample_ns :>>;
event flexsoc_vec_drive_phase;
event flexsoc_vec_sample_phase;

initial forever begin
  @(posedge <<: clk :>>);
  fork
    begin #(FLEXSOC_VEC_DRIVE_NS)  -> flexsoc_vec_drive_phase;  end
    begin #(FLEXSOC_VEC_SAMPLE_NS) -> flexsoc_vec_sample_phase; end
  join_none
end

task automatic tb_wait_drive_phase();
  @flexsoc_vec_drive_phase;
endtask

task automatic tb_wait_sample_phase();
  @flexsoc_vec_sample_phase;
endtask

<<% if packed %>>task automatic tb_drive_input(input tb_token_t name, input logic [31:0] value);
<<% else %>>task automatic tb_drive_input(input string name, input logic [31:0] value);
<<% endif %>><<: drives_text :>>
  else begin
    errors++;
    $display("[TB][ERROR] unknown input vector signal: %s", name);
  end
endtask

<<% if packed %>>task automatic tb_drive_raw(input tb_token_t name, input tb_token_t raw);
<<% else %>>task automatic tb_drive_raw(input string name, input string raw);
<<% endif %>>  logic [32:0] parsed;
  begin : tb_drive_raw_body
<<% if packed %>>    if (tb_token_empty(name)) disable tb_drive_raw_body;
<<% else %>>    if (name == "") disable tb_drive_raw_body;
<<% endif %>>    parsed = tb_parse_u32(raw);
    if (!parsed[32]) disable tb_drive_raw_body;
    tb_drive_input(name, parsed[31:0]);
  end
endtask

<<% if packed %>>task automatic tb_apply_reg_write(input tb_token_t reg_key, input tb_token_t data_raw, input tb_token_t mask_raw);
<<% else %>>task automatic tb_apply_reg_write(input string reg_key, input string data_raw, input string mask_raw);
<<% endif %>>  logic [31:0] data;
  logic [31:0] mask;
  logic [32:0] parsed;
  begin : tb_apply_reg_write_body
    parsed = tb_parse_u32(data_raw);
    if (!parsed[32]) disable tb_apply_reg_write_body;
    data = parsed[31:0];
    parsed = tb_parse_u32(mask_raw);
<<% if packed %>>    if (!tb_token_empty(mask_raw) && parsed[32]) mask = parsed[31:0];
<<% else %>>    if (mask_raw.len() > 0 && parsed[32]) mask = parsed[31:0];
<<% endif %>>    else mask = 32'hffff_ffff;
    apply_reg_masked(reg_key, data, mask);
    tb_vector_apply_count++;
  end
endtask

task automatic tb_apply_reset(
<<% if packed %>>  input tb_token_t selector,
<<% else %>>  input string selector,
<<% endif %>>  input int cycles,
  inout int now_cycle
);
  int i;
  bit selected;
<<: reset_defaults :>>
  selected = (selector == "" || selector == "all" || selector == "*" ||
              selector == "<<: reset_domain :>>" || selector == "<<: rst :>>");
  if (!selected) begin
    errors++;
    $display("[TB][ERROR] unknown reset selector: %s", selector);
  end else begin
    <<: rst :>> = <<: reset_asserted :>>;
    for (i = 0; i < cycles; i++) begin
      tb_wait_sample_phase();
      now_cycle++;
    end
    @(negedge <<: clk :>>); #1;
    <<: rst :>> = <<: reset_released :>>;
    tb_vector_apply_count++;
  end
endtask

task automatic tb_finish_cycle(inout int now_cycle, inout bit cycle_open);
  if (cycle_open) begin
    tb_wait_sample_phase();
    now_cycle++;
    cycle_open = 1'b0;
  end
endtask

task automatic tb_wait_before_drive(input int target_cycle, inout int now_cycle);
  while (now_cycle < target_cycle - 1) begin
    tb_wait_sample_phase();
    now_cycle++;
  end
  tb_wait_drive_phase();
endtask

task automatic tb_drive_signal_pairs(
  input int code,
<<% if packed %>>  input tb_token_t t0,
  input tb_token_t t1,
  input tb_token_t t2,
  input tb_token_t t3,
  input tb_token_t t4,
  input tb_token_t t5,
  input tb_token_t t6,
  input tb_token_t t7
<<% else %>>  input string t0,
  input string t1,
  input string t2,
  input string t3,
  input string t4,
  input string t5,
  input string t6,
  input string t7
<<% endif %>>);
  tb_drive_raw(t0, t1);
  if (code >= 5) tb_drive_raw(t2, t3);
  if (code >= 7) tb_drive_raw(t4, t5);
  if (code >= 9) tb_drive_raw(t6, t7);
endtask

task automatic run_input_vectors(input string input_path);
  int fd;
  int code;
  int cycle;
  int now_cycle;
  int current_cycle;
  int apply_start;
  int event_cursor;
  bit cycle_open;
  bit seen;
  logic [31:0] cycle_value;
  logic [31:0] reset_cycles;
  logic [31:0] expected;
  logic [31:0] timeout;
  logic [32:0] parsed;
<<% if packed %>>  tb_token_t cycle_raw;
  tb_token_t reset_selector;
  tb_line_t line_buf;
  tb_token_t t0;
  tb_token_t t1;
  tb_token_t t2;
  tb_token_t t3;
  tb_token_t t4;
  tb_token_t t5;
  tb_token_t t6;
  tb_token_t t7;
<<% else %>>  string cycle_raw;
  string reset_selector;
  string line;
  reg [8*4096-1:0] line_buf;
  string t0;
  string t1;
  string t2;
  string t3;
  string t4;
  string t5;
  string t6;
  string t7;
<<% endif %>>

  now_cycle = -1;
  current_cycle = -1;
  cycle_open = 1'b0;
  event_cursor = 0;
  apply_start = tb_vector_apply_count;

  begin : run_input_vectors_body
    fd = $fopen(input_path, "r");
    if (fd == 0) begin
      $display("[TB][ERROR] input vector file not found: %s", input_path);
      errors++;
      disable run_input_vectors_body;
    end
    $display("[TB] running input vectors: %s", input_path);

    while (!$feof(fd)) begin : tb_input_line
<<% if packed %>><<% else %>>      line = "";
<<% endif %>>      line_buf = '0;
<<% if packed %>>      code = $fgets(line_buf, fd);
      tb_tokenize9(line_buf, code, cycle_raw, t0, t1, t2, t3, t4, t5, t6, t7);
<<% else %>>      void'($fgets(line_buf, fd));
      line = $sformatf("%0s", line_buf);
      tb_tokenize9(line, code, cycle_raw, t0, t1, t2, t3, t4, t5, t6, t7);
<<% endif %>>
      if (code < 2) disable tb_input_line;
<<% if packed %>>      if (tb_token_comment(cycle_raw) || tb_token_comment(t0)) disable tb_input_line;
<<% else %>>      if (cycle_raw.len() > 0 && cycle_raw.substr(0, 0) == "#") disable tb_input_line;
      if (t0.len() > 0 && t0.substr(0, 0) == "#") disable tb_input_line;
<<% endif %>>
      parsed = tb_parse_u32(cycle_raw);
      if (!parsed[32]) disable tb_input_line;
      cycle_value = parsed[31:0];
      cycle = int'(cycle_value);

      if (t0 == "@wait" || t0 == "wait") begin
        tb_finish_cycle(now_cycle, cycle_open);
        tb_wait_before_drive(cycle, now_cycle);
        tb_wait_sample_phase();
        now_cycle = cycle;
        tb_vector_apply_count++;
        disable tb_input_line;
      end

      if (t0 == "@wait_event" || t0 == "wait_event") begin
        if (code < 4) begin
          errors++;
          $display("[TB][ERROR] malformed @wait_event row");
          disable tb_input_line;
        end
        tb_finish_cycle(now_cycle, cycle_open);
        tb_wait_before_drive(cycle, now_cycle);
        parsed = tb_parse_u32(t2);
        if (!parsed[32]) disable tb_input_line;
        expected = parsed[31:0];
        parsed = tb_parse_u32(t3);
        timeout = parsed[32] ? parsed[31:0] : 32'd1024;
        seen = 1'b0;
        tb_wait_event(t1, expected, int'(timeout), event_cursor, seen);
        if (!seen) begin
          errors++;
          $display("[TB][ERROR] event timeout name=%s value=0x%08x", t1, expected);
        end
        now_cycle = -1;
        current_cycle = -1;
        cycle_open = 1'b0;
        tb_vector_apply_count++;
        disable tb_input_line;
      end

      if (t0 == "@wait_signal" || t0 == "wait_signal") begin
        if (code < 4) begin
          errors++;
          $display("[TB][ERROR] malformed @wait_signal row");
          disable tb_input_line;
        end
        tb_finish_cycle(now_cycle, cycle_open);
        tb_wait_before_drive(cycle, now_cycle);
        parsed = tb_parse_u32(t2);
        if (!parsed[32]) disable tb_input_line;
        expected = parsed[31:0];
        parsed = tb_parse_u32(t3);
        timeout = parsed[32] ? parsed[31:0] : 32'd1024;
        seen = 1'b0;
        tb_wait_signal(t1, expected, int'(timeout), seen);
        if (!seen) begin
          errors++;
          $display("[TB][ERROR] signal timeout name=%s value=0x%08x", t1, expected);
        end
        now_cycle = -1;
        current_cycle = -1;
        cycle_open = 1'b0;
        tb_vector_apply_count++;
        disable tb_input_line;
      end

      if (t0 == "@cfg" || t0 == "cfg" || t0 == "@config" || t0 == "config") begin
        tb_finish_cycle(now_cycle, cycle_open);
        tb_wait_before_drive(cycle, now_cycle);
        load_config(t1);
        tb_vector_apply_count++;
        disable tb_input_line;
      end

      if (t0 == "@reset" || t0 == "reset") begin
        tb_finish_cycle(now_cycle, cycle_open);
        tb_wait_before_drive(cycle, now_cycle);
        if (code >= 4) parsed = tb_parse_u32(t2);
        else parsed = tb_parse_u32(t1);
        reset_cycles = parsed[32] ? parsed[31:0] : 32'd2;
        reset_selector = code >= 4 ? t1 : "all";
        tb_apply_reset(reset_selector, int'(reset_cycles), now_cycle);
        disable tb_input_line;
      end

      if (t0 == "@write" || t0 == "write" || t0 == "@reg_write" || t0 == "reg_write") begin
        if (code < 4) begin
          errors++;
          $display("[TB][ERROR] malformed @write row");
          disable tb_input_line;
        end
        tb_finish_cycle(now_cycle, cycle_open);
        tb_wait_before_drive(cycle, now_cycle);
        tb_apply_reg_write(t1, t2, t3);
        disable tb_input_line;
      end

      if ((code - 1) % 2 != 0) begin
        errors++;
        $display("[TB][ERROR] malformed signal vector row");
        disable tb_input_line;
      end
      if (!cycle_open || cycle != current_cycle) begin
        tb_finish_cycle(now_cycle, cycle_open);
        tb_wait_before_drive(cycle, now_cycle);
        current_cycle = cycle;
        cycle_open = 1'b1;
      end
      tb_drive_signal_pairs(code, t0, t1, t2, t3, t4, t5, t6, t7);
    end

    $fclose(fd);
    tb_finish_cycle(now_cycle, cycle_open);
    if (tb_vector_apply_count == apply_start) begin
      errors++;
      $display("[TB][ERROR] no vector inputs or commands were applied from %s", input_path);
    end
  end
endtask

task automatic run_vectors(input string input_path, input string output_path);
  fork
    run_input_vectors(input_path);
    run_output_vectors(output_path);
  join
endtask
