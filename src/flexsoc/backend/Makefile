FLEXSOC_PARAMS := CDC_RDC_HEARTBEAT CDC_RDC_STRICT CLK_PERIOD CLOCK_DOMAINS CLOCK_RELATIONSHIPS COCOTB_WAVES COMPILER COVERAGE COVERAGE_DETAIL_LIMIT DATA_IN DATA_OUT DEPS_JOBS DEPS_MODE DEPS_PROFILE DEPS_PRUNE_APPLY DEPS_PRUNE_CACHE DEVLIST EQY EQY_DEPTH EQY_ENGINE EQY_JOBS EQY_JOIN_OUTPUTS EQY_PDR_ENGINE EQY_QUICK_TIMEOUT EQY_RESET_CYCLES EQY_RESET_NORMALIZE EQY_SAT_DEPTH EQY_SMT_DEPTH EQY_SMT_ENGINE EQY_SPLITNETS EQY_STRATEGY_ORDER EQY_TIMEOUT EQY_USE_PDR EQY_USE_SAT EQY_XPROP FORCE FORMAL_BMC_APPEND FORMAL_BMC_DEPTH FORMAL_BMC_ENGINE FORMAL_COVER_ENGINE FORMAL_DEPTH FORMAL_PDK_PROC FORMAL_PROVE_ENGINE FSM FST2VCD GLS_BACKEND GLS_SIMULATOR GLS_UNIT_DELAY HOST IP_LIBRARY_ROOT IP_NAME LIBS LIB_SYN LINT_PART LINT_TOOL MACRO_LIBS MIN_BUF_CELL_AND_PORTS NETLIST NPATHS N_CLOCKS ORS ORS_TECH PATH_VIEW_FILE PDK PDK_ROOT PNR_SDC_FILE POWER_ACTIVITY POWER_DUTY POWER_DUT_INSTANCE POWER_GLOBAL_ACTIVITY POWER_GLS_BACKEND POWER_GLS_BACKENDS POWER_TEST_NAME POWER_TEST_NAMES POWER_TIMING_MODE POWER_TIMING_MODES POWER_TOP_INSTANCES POWER_VCD_SCOPE PRIM REGCFG REGRESSION_BACKENDS REG_ITF RUN_ID RUN_TOP SBY SDF_CORNER SDF_FILE SDF_STRICT SEED SIGNOFF_STAGE SLANG_ARGS SLANG_AST_SCOPE SLANG_ROOT SLANG_SEARCH_ARGS SLANG_TOP SLANG_TOP_FILE SOC_CFG_MODE SPEF_FILE STA_ENDPOINT_GROUP_LIMIT STA_ENDPOINT_PATH_LIMIT STA_NEAR_CRITICAL_HOLD STA_NEAR_CRITICAL_SETUP SURFER_BACKEND TARGET TARGET_OPT TARGET_SYN TESTBENCH TEST_NAME TEST_NAMES TEST_ROOT TIEHI_CELL_AND_PORT TIELO_CELL_AND_PORT TIMING_MODE TIMING_MODES TOP TUTORIAL_RUN_ID TUTORIAL_WS VENDOR VSV WAVE_FILE WAVE_FORMAT WAVE_VIEWER WORKSPACE

# Only command-line Make overrides are forwarded; Python owns defaults.
FLEXSOC_SET_ARGS = $(foreach key,$(FLEXSOC_PARAMS),$(if $(filter command line,$(origin $(key))),--set $(key)=$($(key)),))

.PHONY: $(FLEXSOC_TARGETS)
$(FLEXSOC_TARGETS):
	@$(PYTHON) -m flexsoc $@ --project-root "$(REPO_ROOT)" --workdir "$(WORKSPACE)" $(FLEXSOC_SET_ARGS)
