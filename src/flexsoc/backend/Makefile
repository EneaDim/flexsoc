# FlexSoC compatibility Make shim. Backend logic lives in Python flow objects.

PYTHON ?= python3
REPO_ROOT ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../..)
WORKSPACE ?= $(REPO_ROOT)/workspace
export PYTHONPATH := $(REPO_ROOT)/src$(if $(PYTHONPATH),:$(PYTHONPATH),)

FLEXSOC_TARGETS := help help_ip help_soc help_doc help_fsm setup soc_cfg soc_start sta_corners power_estimate_corners signoff_corners hjson hjson_gen reg doc rtl_stub top_from_core flist driver fetch ip_start ip_flow ip_flow_noreg ip_flow_all lint lint_slang lint_verilator lint_slang_suite lint_verilator_suite lint_suite setup_cdc_rdc cdc_rdc lint_v lint_sv lint_latch lint_undriven lint_width lint_unconnected lint_unused _lint_run slang_hier slang_ast slang_flist setup_tb setup_cocotb setup_model regmap_py tests_gen test_gen tests compile compile_v compile_sv sim sim_v sim_sv sim_tests cocotb cocotb_tests regression coverage coverage_detail view view_cocotb view_syn plot_postsyn view_presyn view_presyn_v view_presyn_sv tb_save tb_view setup_syn syn syn_v syn_sv yosys-vgen sv2v setup_formal setup_formal_csr_prove setup_formal_csr_cover formal_csr_bmc formal_csr_prove formal_csr_cover formal_csr formal setup_formal_prove setup_formal_cover formal_bmc formal_prove formal_cover setup_eqy eqy setup_signoff compile_syn sim_syn compile_post_syn sim_post_syn sim_post_syn_all compile_post_pnr setup_signoff_post_pnr signoff_post_pnr sdf_post_pnr sta_post_pnr power_estimate_post_pnr sim_post_pnr sim_post_pnr_all power_analysis_post_pnr power_analysis_post_pnr_all fusion_analysis_post_pnr fusion_analysis_post_pnr_all sta sdf power_estimate power_analysis power_analysis_all fusion_analysis fusion_analysis_all sta_violators path_view metrics manifest manifest_show check setup_pnr pnr pnr_gui physical_signoff ip_load ip_save soc_vendor_deps fsoc_init fsoc xbar xbar_init xbar_build soc soc_stage_tops soc_flist soc_flow soc_uart_gen soc_ibex_gen sw_soc soc_prepare soc_build_sw soc_sim soc_run soc_run_only soc_view fsm_init fsm_setup fsm_example_load fsm_gen fsm_plot fsm_flow fsm_install fsm2rtl soc_uart_tutorial soc_ibex_fetch soc_ibex_tutorial full_tutorial fsm_tutorial ip_tutorial soc_pless deps-bootstrap deps deps-doctor deps-versions deps-env deps-status deps-prune clean-pyc cle