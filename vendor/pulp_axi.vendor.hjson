// FlexSoC vendored subset of PULP AXI used by axi_lite_to_reg.
// The generated lock file records the resolved full upstream commit.
{
  name: "pulp_axi",
  target_dir: "pulp/axi",

  upstream: {
    url: "https://github.com/pulp-platform/axi.git",
    rev: "fccffb5", // v0.39.1
  },

  mapping: [
    {from: "LICENSE", to: "LICENSE"},
    {from: "src/axi_pkg.sv", to: "src/axi_pkg.sv"},
    {from: "src/axi_intf.sv", to: "src/axi_intf.sv"},
    {from: "include/axi", to: "include/axi"},
  ]
}
