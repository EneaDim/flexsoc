{
  "states": ["RESET","IDLE","DECODE","EXEC","RESP","ERROR"],
  "transitions": [
    { "from": "RESET", "to": "IDLE", "cond": "reset_done_i" },

    { "from": "IDLE", "to": "DECODE", "cond": "csr_req_i" },

    { "from": "DECODE", "to": "ERROR", "cond": "csr_illegal_i" },
    { "from": "DECODE", "to": "EXEC", "cond": "!csr_illegal_i" },

    { "from": "EXEC", "to": "EXEC", "cond": "!exec_ready_i" },
    { "from": "EXEC", "to": "RESP", "cond": "exec_ready_i & !csr_err_i" },
    { "from": "EXEC", "to": "ERROR", "cond": "csr_err_i" },

    { "from": "RESP", "to": "IDLE", "cond": "csr_rsp_hs_i" },

    { "from": "ERROR", "to": "IDLE", "cond": "clear_error_i" }
  ],
  "outputs_header": ["busy_o","valid_o","error_o","low_power_o","dbg_o"],
  "outputs": {
    "RESET":  { "busy_o": 0, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "IDLE":   { "busy_o": 0, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "DECODE": { "busy_o": 1, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 1 },
    "EXEC":   { "busy_o": 1, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "RESP":   { "busy_o": 1, "valid_o": 1, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "ERROR":  { "busy_o": 0, "valid_o": 0, "error_o": 1, "low_power_o": 0, "dbg_o": 1 }
  },
  "assumptions": [
    "csr_rsp_hs_i è handshake (rsp_valid&rsp_ready).",
    "csr_err_i rappresenta errore di esecuzione (es. bus error su CSR)."
  ]
}
