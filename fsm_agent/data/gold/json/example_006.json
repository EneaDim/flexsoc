{
  "states": ["RESET","IDLE","FETCH","SEND","STALL","ERROR"],
  "transitions": [
    { "from": "RESET", "to": "IDLE", "cond": "reset_done_i" },
    { "from": "IDLE", "to": "FETCH", "cond": "start_i" },
    { "from": "FETCH", "to": "SEND", "cond": "mem_done_i & !error_i" },
    { "from": "FETCH", "to": "ERROR", "cond": "error_i" },

    { "from": "SEND", "to": "STALL", "cond": "!out_ready_i" },
    { "from": "STALL", "to": "SEND", "cond": "out_ready_i" },

    { "from": "SEND", "to": "IDLE", "cond": "last_sent_i & out_ready_i & !error_i" },
    { "from": "SEND", "to": "ERROR", "cond": "error_i" },

    { "from": "ERROR", "to": "IDLE", "cond": "clear_error_i" }
  ],
  "outputs_header": ["busy_o","valid_o","error_o","low_power_o","dbg_o"],
  "outputs": {
    "RESET": { "busy_o": 0, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "IDLE":  { "busy_o": 0, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "FETCH": { "busy_o": 1, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "SEND":  { "busy_o": 1, "valid_o": 1, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "STALL": { "busy_o": 1, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 1 },
    "ERROR": { "busy_o": 0, "valid_o": 0, "error_o": 1, "low_power_o": 0, "dbg_o": 1 }
  },
  "assumptions": [
    "mem_done_i indica che il dato è pronto da inviare.",
    "last_sent_i indica l'ultimo beat del frame.",
    "In STALL dbg_o=1 per debug backpressure."
  ]
}
