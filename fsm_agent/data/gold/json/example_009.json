{
  "states": ["RESET","IDLE","GNT0","GNT1"],
  "transitions": [
    { "from": "RESET", "to": "IDLE", "cond": "reset_done_i" },

    { "from": "IDLE", "to": "GNT0", "cond": "req0_i & !req1_i" },
    { "from": "IDLE", "to": "GNT1", "cond": "req1_i & !req0_i" },

    { "from": "IDLE", "to": "GNT0", "cond": "req0_i & req1_i & (last_grant_i == 1'b1)" },
    { "from": "IDLE", "to": "GNT1", "cond": "req0_i & req1_i & (last_grant_i == 1'b0)" },

    { "from": "GNT0", "to": "GNT0", "cond": "req0_i" },
    { "from": "GNT0", "to": "IDLE", "cond": "!req0_i" },

    { "from": "GNT1", "to": "GNT1", "cond": "req1_i" },
    { "from": "GNT1", "to": "IDLE", "cond": "!req1_i" }
  ],
  "outputs_header": ["busy_o","valid_o","error_o","low_power_o","dbg_o"],
  "outputs": {
    "RESET": { "busy_o": 0, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "IDLE":  { "busy_o": 0, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 0 },
    "GNT0":  { "busy_o": 1, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 1 },
    "GNT1":  { "busy_o": 1, "valid_o": 0, "error_o": 0, "low_power_o": 0, "dbg_o": 1 }
  },
  "assumptions": [
    "last_grant_i è un bit: 1 indica ultimo grant a master1, 0 indica master0 (convenzione scelta per round-robin).",
    "L'arbiter resta sul grant finché la richiesta rimane alta."
  ]
}
