CAPI=2:
name: "prj:ip:gpio:0.1"
description: "gpio"
filesets:
  files_rtl:
    depend:
      - ips:dependecies:all
    files:
      - rtl/gpio_reg_pkg.sv
      - rtl/gpio_reg_top.sv
      - rtl/gpio.sv
    file_type: systemVerilogSource


targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: gpio

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Wno-fatal"

