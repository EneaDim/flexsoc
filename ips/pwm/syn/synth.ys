# read files
read_verilog rtl/pwm.v
# basic synth
synth -top pwm -noabc
show -width -format dot -prefix syn/plots/pwm_postsyn
# map internal register types to the ones from the cell library
dfflibmap -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib
# mapping to internal cell library
# mapping to internal cell library
abc -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib -script syn/area.abc \
    -constr ors/pwm.sdc \


opt_clean -purge
stat -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib
# write verilog
write_verilog syn/pwm_synth.v
# write json
write_json syn/pwm_synth.json
