# read files (SystemVerilog via slang)
read_slang -I ips/pkgs \
           -I ips/prim \
           -I ips/prim_opentitan \
           -I ips/tlul \
           -D SYNTHESIS \
           --ignore-assertions \
           -f rtl/rtl_list.f \
           --top rv_timer

# basic synth
synth -top rv_timer -noabc

# map internal register types to the ones from the cell library
dfflibmap -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# mapping to internal cell library
abc -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib -script syn/area.abc \
    -constr ors/rv_timer.sdc \

# Clean
opt_clean -purge

# Basic stats of std cells and area
stat -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# write verilog
write_verilog syn/rv_timer_synth.v
# write json
write_json syn/rv_timer_synth.json
